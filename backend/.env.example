# Server Port & Environment
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000


# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=campusedge
DB_PORT=5432

# Authentication & Security Secrets (Required: Generate strong random secrets)
JWT_SECRET=your_long_random_jwt_secret_key_at_least_32_chars
ADMIN_SECRET_KEY=your_secure_admin_registration_passphrase

# AI Integration
GEMINI_API_KEY=your_google_gemini_api_key

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Service (Nodemailer - Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
